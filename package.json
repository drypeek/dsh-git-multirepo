{
  "name": "dsh-git-multirepo",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Browse every Git repository in a DSH workspace: one merged commit timeline and a combined working-tree changes view.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "git-log",
    "git-diff",
    "git-status",
    "multi-repo",
    "monorepo",
    "working-tree"
  ],
  "author": "drypeek (https://github.com/drypeek)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drypeek/dsh-git-multirepo.git"
  },
  "homepage": "https://github.com/drypeek/dsh-git-multirepo#readme",
  "bugs": {
    "url": "https://github.com/drypeek/dsh-git-multirepo/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test",
    "prepublishOnly": "npm run check && npm test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
